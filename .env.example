# Examples only. The application does not automatically read this file.
# Set values in your process environment or secure environment settings.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5088

# Development defaults to clearly labelled demo replies.
Chat__Mode=Demo

# SqlServer is the default. Sqlite is an optional Development-only local demo.
Database__Provider=SqlServer

# To enable live replies, set Chat__Mode=OpenAI and supply your key securely.
# Never put permanent provider credentials into Angular configuration.
DadusOpenAI__ApiKey=
DadusOpenAI__Model=gpt-4o-mini

# Gemini alternative: set Chat__Mode=Gemini and use a Google AI Studio key.
# Free-tier model eligibility and quotas depend on your Google project.
DadusGemini__ApiKey=
DadusGemini__Model=gemini-3.8-flash

# The local SQL helper injects this into its child process automatically.
# For your own SQL Server, set an actual connection string in the environment.
ConnectionStrings__Dadus=
